rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in owner can read and change their bookmarks.
    match /users/{userId}/bookmarks/{bookmarkId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validBookmark() {
        return request.resource.data.keys().hasOnly([
          'title', 'author', 'sourceUrl', 'variant', 'savedAt'
        ]) && request.resource.data.keys().hasAll([
          'title', 'author', 'sourceUrl', 'variant', 'savedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 250
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 250
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 500
        && request.resource.data.variant in ['original', 'improved']
        && request.resource.data.savedAt is timestamp;
      }
      allow read, delete: if isOwner();
      allow create: if isOwner() && validBookmark();
      allow update: if isOwner() && validBookmark()
        && request.resource.data.variant == resource.data.variant;
    }
  }
}
