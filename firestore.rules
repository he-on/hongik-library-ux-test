rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // UX task research: anonymous, write-only submissions (no public reads).
    match /uxTaskResponses/{responseId} {
      allow get, list, update, delete: if false;
      allow create: if request.auth != null
        && responseId.matches('^[0-9a-f-]{32,40}$')
        && request.resource.data.keys().hasOnly([
          'anonymousUid', 'participantId', 'variant', 'taskId', 'taskDate',
          'answer', 'difficulty', 'elapsedSeconds',
          'startedAt', 'answeredAt', 'completedAt'
        ])
        && request.resource.data.keys().hasAll([
          'anonymousUid', 'participantId', 'variant', 'taskId', 'taskDate',
          'answer', 'difficulty', 'elapsedSeconds',
          'startedAt', 'answeredAt', 'completedAt'
        ])
        && request.resource.data.anonymousUid == request.auth.uid
        && request.resource.data.participantId is string
        && request.resource.data.participantId.matches('^uxp-[0-9a-f]{12}$')
        && request.resource.data.variant in ['original', 'improved']
        && request.resource.data.taskId == 'library-hours-today-v1'
        && request.resource.data.taskDate is string
        && request.resource.data.taskDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 300
        && request.resource.data.difficulty is int
        && request.resource.data.difficulty >= 1
        && request.resource.data.difficulty <= 5
        && request.resource.data.elapsedSeconds is int
        && request.resource.data.elapsedSeconds >= 0
        && request.resource.data.elapsedSeconds <= 86400
        && request.resource.data.startedAt is timestamp
        && request.resource.data.answeredAt is timestamp
        && request.resource.data.completedAt is timestamp;
    }

    // UX test only: a shared ID is public to anyone who knows it.
    // Anonymous Firebase Auth is merely an anti-accidental-public-read gate,
    // NOT proof that the visitor owns this ID.
    match /profiles/{alias} {
      function allowed() {
        return request.auth != null
          && alias.matches('^[a-z0-9][a-z0-9-]{4,29}$');
      }
      allow get: if allowed();
      allow list: if false;
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;

      match /bookmarks/{bookmarkId} {
        function allowedBook() {
          return request.auth != null
            && alias.matches('^[a-z0-9][a-z0-9-]{4,29}$');
        }
        function validDetails() {
          let d = request.resource.data.details;
          return d is map
            && d.keys().hasOnly([
              'materialType', 'publication', 'availability', 'library',
              'location', 'callNumber', 'holdingsText', 'detailUrl'
            ])
            && d.get('materialType', '') is string
            && d.get('materialType', '').size() <= 80
            && d.get('publication', '') is string
            && d.get('publication', '').size() <= 300
            && d.get('availability', '') is string
            && d.get('availability', '').size() <= 80
            && d.get('library', '') is string
            && d.get('library', '').size() <= 120
            && d.get('location', '') is string
            && d.get('location', '').size() <= 250
            && d.get('callNumber', '') is string
            && d.get('callNumber', '').size() <= 140
            && d.get('holdingsText', '') is string
            && d.get('holdingsText', '').size() <= 1500
            && d.get('detailUrl', '') is string
            && d.get('detailUrl', '').size() <= 500;
        }
        function validBook() {
          return request.resource.data.keys().hasOnly([
            'title', 'author', 'sourceUrl', 'variant', 'savedAt', 'details'
          ]) && request.resource.data.keys().hasAll([
            'title', 'author', 'sourceUrl', 'variant', 'savedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 250
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 250
          && request.resource.data.sourceUrl is string
          && request.resource.data.sourceUrl.size() <= 500
          && request.resource.data.variant in ['original', 'improved']
          && request.resource.data.savedAt is timestamp
          // Existing bookmarks (without details) remain readable and valid.
          && (!request.resource.data.keys().hasAny(['details']) || validDetails());
        }
        allow get, list, delete: if allowedBook();
        allow create: if allowedBook() && validBook();
        allow update: if allowedBook() && validBook()
          && request.resource.data.variant == resource.data.variant;
      }
    }
  }
}
